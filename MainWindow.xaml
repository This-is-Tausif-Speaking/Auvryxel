<Window x:Class="Auvryxel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Auvryxel" Icon="pack://application:,,,/Assets/Auvryxel.ico" Width="1260" Height="820" MinWidth="780" MinHeight="560"
        WindowStyle="None" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource MainText}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" /><Setter Property="Foreground" Value="{DynamicResource MainText}" /></Style>
    <Style TargetType="TextBox"><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" /><Setter Property="Foreground" Value="{DynamicResource MainText}" /></Style>
    <Style x:Key="PopupAction" TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="12,9"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="3,1"/></Style>
  </Window.Resources>
  <Grid Background="{DynamicResource AppBackground}">
    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="48"/><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="25"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource ChromeBackground}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid Margin="12,0,7,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
          <Border Width="22" Height="22" CornerRadius="7" Background="#14221F" Margin="0,0,8,0">
            <Viewbox Margin="4"><Canvas Width="32" Height="32"><Path Data="M 5,27 L 16,5 L 27,27 M 10,17 L 22,17" Stroke="{DynamicResource LogoMark}" StrokeThickness="2.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /><Path Data="M 16,3 L 17.6,7.2 L 22,8.8 L 17.6,10.4 L 16,14.8 L 14.4,10.4 L 10,8.8 L 14.4,7.2 Z" Fill="{DynamicResource LogoMark}" /></Canvas></Viewbox>
          </Border>
          <TextBlock Text="auvryxel" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MainText}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="Your own way through the web" FontSize="11" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Style="{StaticResource IconButton}" Content="—" Width="39" Padding="0" Click="Minimize_Click" ToolTip="Minimize" />
          <Button Style="{StaticResource IconButton}" Content="□" Width="39" Padding="0" Click="Maximize_Click" ToolTip="Maximize" />
          <Button Style="{StaticResource IconButton}" Content="×" Width="39" Padding="0" Click="Close_Click" ToolTip="Close" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="{DynamicResource ChromeBackground}" Padding="10,0,8,7">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="TabPickerButton" Grid.Column="0" Style="{StaticResource IconButton}" Padding="10,7" Click="TabPickerButton_Click" ToolTip="Choose a tab">
          <StackPanel Orientation="Horizontal"><TextBlock Text="Tabs" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock x:Name="TabCountText" Text="1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text=" v" FontSize="10" VerticalAlignment="Center"/></StackPanel>
        </Button>
        <Border x:Name="CurrentTabHeader" Grid.Column="1" Width="250" Height="37" Margin="5,0,0,0" CornerRadius="9,9,0,0" Background="{DynamicResource SurfaceBackground}">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="CurrentTabTitle" Grid.Column="0" Text="New tab" FontSize="12" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="13,0,4,0"/>
            <Button Grid.Column="1" Content="&#x00D7;" Style="{StaticResource IconButton}" Padding="3" Margin="0,4,4,4" FontSize="14" Click="CloseCurrentTab_Click" ToolTip="Close tab"/>
          </Grid>
        </Border>
        <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="+" FontSize="20" Padding="8,0" Click="NewTab_Click" ToolTip="New tab (Ctrl+T)"/>
        <Popup x:Name="TabsPopup" PlacementTarget="{Binding ElementName=TabPickerButton}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None">
          <Border Width="300" MaxHeight="420" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="10" Padding="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Tabs}">
              <ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource PopupAction}" Click="TabPickerItem_Click"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/></Button></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl></ScrollViewer>
          </Border>
        </Popup>
      </Grid>
    </Border>
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,0,1" Padding="14,8">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button Grid.Column="0" Style="{StaticResource IconButton}" Content="‹" FontSize="22" Padding="11,0" Click="Back_Click" ToolTip="Back" />
        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="›" FontSize="22" Padding="11,0" Click="Forward_Click" ToolTip="Forward" />
        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="↻" FontSize="18" Padding="10,0" Click="Reload_Click" ToolTip="Reload" />
        <Border Grid.Column="3" Background="{DynamicResource FieldBackground}" CornerRadius="10" Height="36" Margin="7,0,10,0" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="◈" Foreground="{DynamicResource AccentBrush}" FontSize="14" Margin="13,0,8,0" VerticalAlignment="Center" ToolTip="Strict tracking protection is on" />
            <TextBox x:Name="AddressBox" Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="13" VerticalContentAlignment="Center" Padding="0" KeyDown="AddressBox_KeyDown" GotKeyboardFocus="AddressBox_GotKeyboardFocus" />
            <Button x:Name="BookmarkButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="☆" Padding="10,2" FontSize="19" Click="Bookmark_Click" ToolTip="Save this link" />
          </Grid>
        </Border>
        <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="⌂" FontSize="19" Padding="11,2" Click="Home_Click" ToolTip="Home" />
        <Button x:Name="MenuButton" Grid.Column="5" Style="{StaticResource IconButton}" Content="&#x22EF;" FontSize="20" Padding="11,2" Click="Menu_Click" ToolTip="Auvryxel menu"/>
        <Popup x:Name="AppMenuPopup" PlacementTarget="{Binding ElementName=MenuButton}" Placement="Bottom" HorizontalOffset="-210" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None">
          <Border Width="246" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="11" Padding="5"><StackPanel>
            <Button Style="{StaticResource PopupAction}" Content="New tab" Click="MenuNewTab_Click"/>
            <Button Style="{StaticResource PopupAction}" Content="Save current link" Click="MenuSaveLink_Click"/>
            <Border Height="1" Background="{DynamicResource BorderBrushColor}" Margin="8,5"/>
            <Button x:Name="ThemeMenuItem" Style="{StaticResource PopupAction}" Content="Switch to dark mode" Click="ToggleTheme_Click"/>
            <Button Style="{StaticResource PopupAction}" Content="Open downloads folder" Click="OpenDownloads_Click"/>
            <Button Style="{StaticResource PopupAction}" Content="Clear browsing data..." Click="ClearData_Click"/>
            <Border Height="1" Background="{DynamicResource BorderBrushColor}" Margin="8,5"/>
            <Button Style="{StaticResource PopupAction}" Content="Privacy dashboard" Click="PrivacyDashboard_Click"/>
            <Button Style="{StaticResource PopupAction}" Content="About Auvryxel" Click="About_Click"/>
          </StackPanel></Border>
        </Popup>
      </Grid>
    </Border>
    <Grid Grid.Row="3" Background="{DynamicResource AppBackground}">
      <Grid x:Name="BrowserHost" Visibility="Collapsed" />
      <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto" Background="{DynamicResource AppBackground}">
        <Grid MaxWidth="940" Margin="48,0" HorizontalAlignment="Center">
          <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="47"/><RowDefinition Height="Auto"/><RowDefinition Height="38"/><RowDefinition Height="Auto"/><RowDefinition Height="45"/><RowDefinition Height="Auto"/><RowDefinition Height="42"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Width="42" Height="42" CornerRadius="14" Background="#14221F" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,15">
            <Viewbox Margin="7"><Canvas Width="32" Height="32"><Path Data="M 5,27 L 16,5 L 27,27 M 10,17 L 22,17" Stroke="{DynamicResource LogoMark}" StrokeThickness="2.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /><Path Data="M 16,3 L 17.6,7.2 L 22,8.8 L 17.6,10.4 L 16,14.8 L 14.4,10.4 L 10,8.8 L 14.4,7.2 Z" Fill="{DynamicResource LogoMark}" /></Canvas></Viewbox>
          </Border>
          <TextBlock Grid.Row="1" Text="Auvryxel" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Grid.Row="3" Text="A quieter way to reach the web." FontSize="14" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center" />
          <Border Grid.Row="5" Background="{DynamicResource CardBackground}" CornerRadius="16" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" Padding="21,17" HorizontalAlignment="Stretch">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="YOUR LINKS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedText}" Margin="0,0,0,12" />
                <WrapPanel x:Name="QuickLinksPanel" />
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="+" FontSize="18" VerticalAlignment="Top" Click="AddLink_Click" ToolTip="Add a quick link" />
            </Grid>
          </Border>
          <Border Grid.Row="7" Background="{DynamicResource CardBackground}" CornerRadius="16" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" Padding="21,17">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <DockPanel><TextBlock Text="ON THIS DEVICE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedText}"/><TextBlock x:Name="StorageLabel" DockPanel.Dock="Right" FontSize="10" Foreground="{DynamicResource MutedText}" /></DockPanel>
              <TextBlock x:Name="StoragePathLabel" Grid.Row="2" FontSize="11" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>
          <TextBlock Grid.Row="9" Text="Your profile stays in this Windows user folder." FontSize="11" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center" />
        </Grid>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="4" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,1,0,0" Padding="13,0">
      <DockPanel><TextBlock Text="Auvryxel" FontSize="10" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/><TextBlock x:Name="StatusText" Text="Ready when you are" FontSize="10" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Right" /></DockPanel>
    </Border>
  </Grid>
</Window>
